# ==============================================================================
# rental_server 本番環境用環境変数テンプレート (.env.example)
#
# さくらインターネット等のレンタルサーバーにデプロイする際、
# このファイルをコピーして .env を作成し、実際の運用値に設定してください:
#   cp .env.example .env
#
# ※シークレットキー（API_KEY, OAUTH_BRIDGE_SECRET）は以下でランダム生成できます:
#   python manage.py gen-secrets
# ==============================================================================

# 本番運用フラグ (0: 本番モード)
MAILMGR_DEV=0

# 実IMAPサーバー接続モード (0: 実メールサーバーに接続)
IMAP_MOCK=0

# アプリケーションの公開ベースURL（末尾スラッシュ必須）
APP_BASE_URL=https://your-domain.sakura.ne.jp/mailmgr/

# 本番IMAPサーバー接続設定
IMAP_HOST=mail.your-domain.sakura.ne.jp
IMAP_PORT=993
IMAP_USER=job-hunting@your-domain.sakura.ne.jp
IMAP_PASSWORD=your-secure-imap-password

# 内部通信・管理用APIキー (32文字以上。python manage.py gen-secrets で生成)
API_KEY=your-production-api-key-min-32-chars-long

# mcp_server と共有する OAuth Bridge シークレット (32文字以上。python manage.py gen-secrets で生成)
OAUTH_BRIDGE_SECRET=your-production-oauth-bridge-secret-min-32-chars-long

# ------------------------------------------------------------------------------
# オプション設定 (必要に応じて変更)
# ------------------------------------------------------------------------------
# MCPサーバーの公開URL（CORS/OAuth連携用）
# MCP_PUBLIC_URL=https://your-mcp-server.vercel.app

# データ保存ディレクトリ（デフォルト: data）
# DATA_DIR=data

# セッションおよび実行制限設定
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# GRANT_IDLE_DAYS=30
# RUN_TIME_BUDGET_SECONDS=20

